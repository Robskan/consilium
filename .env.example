DATABASE_URL= # e.g. "postgresql://consilium:change-me@localhost:5432/consilium"

BETTER_AUTH_SECRET= # run `openssl rand -base64 32` to generate one
BETTER_AUTH_URL=http://localhost:3000

DISCORD_CLIENT_ID= # create a discord app and get this from the developer portal
DISCORD_CLIENT_SECRET= # create a discord app and get this from the developer portal

POSTGRES_USER=consilium
POSTGRES_PASSWORD= # use this in the db url
POSTGRES_DB=consilium

SPREADSHEET_IDS= # comma separated list of spreadsheet ids to sync with, e.g. "id1,id2"
# GOOGLE_APPLICATION_CREDENTIALS= # optional path to service account JSON (default: ./credentials.json)
# GOOGLE_SERVICE_ACCOUNT_JSON= # optional inline service account JSON (alternative to credentials.json)

FILE_STORAGE_PATH=./data/files
MAX_FILE_SIZE= # maximum file size in bytes, e.g. 52428800 for 50MB

CRON_SECRET= # run `openssl rand -base64 32` to generate one